<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kiểm tra cuối học kỳ I - Toán 10</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    window.MathJax = {
      tex: { inlineMath: [['$', '$'], ['\\(', '\\)']] },
      svg: { fontCache: 'global' }
    };
  </script>
  <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
  <style>
    body {
      font-family: "Segoe UI", Roboto, Arial, sans-serif;
      background-color: #f1f5f9;
    }
    .card {
      background: #ffffff;
      border-radius: 12px;
      box-shadow: 0 2px 10px rgba(15, 23, 42, 0.06);
    }
  </style>
</head>
<body class="p-3 sm:p-6 text-slate-800">
  <div class="max-w-4xl mx-auto space-y-6">

    <!-- Thông tin đề thi & học sinh -->
    <div class="card p-6 border-t-4 border-blue-600">
      <div class="text-center">
        <p class="text-xs sm:text-sm font-semibold uppercase tracking-wide text-slate-500">
          Sở GD&ĐT Thành phố Đà Nẵng — Trường THPT Nguyễn Thái Bình
        </p>
        <h1 class="text-xl sm:text-2xl font-bold text-blue-900 mt-1">
          ĐỀ KIỂM TRA CUỐI HỌC KỲ I
        </h1>
        <p class="font-semibold text-slate-700 mt-0.5">MÔN: TOÁN - KHỐI 10</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-6">
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1">
            Họ và tên học sinh <span class="text-red-500">*</span>
          </label>
          <input id="hoTen" type="text" placeholder="Nhập họ và tên..."
            class="w-full border border-slate-300 rounded-lg px-3 py-2 focus:outline-none focus:border-blue-500" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1">
            Lớp <span class="text-red-500">*</span>
          </label>
          <input id="lop" type="text" placeholder="Ví dụ: 10A1"
            class="w-full border border-slate-300 rounded-lg px-3 py-2 focus:outline-none focus:border-blue-500" />
        </div>
      </div>
    </div>

    <!-- PHẦN I -->
    <div class="card p-6">
      <h2 class="text-lg font-bold text-blue-800 border-b border-slate-200 pb-2 mb-4">
        PHẦN I. Câu trắc nghiệm nhiều phương án lựa chọn
      </h2>
      <div id="phan1-list" class="space-y-4"></div>
    </div>

    <!-- PHẦN II -->
    <div class="card p-6">
      <h2 class="text-lg font-bold text-blue-800 border-b border-slate-200 pb-2 mb-4">
        PHẦN II. Câu trắc nghiệm đúng sai
      </h2>
      <p class="font-medium text-slate-800 mb-3">
        <strong>Câu 2.</strong> Cho hình vuông $ABCD$ tâm $O$ cạnh $a$. Gọi $M$ là trung điểm của đoạn thẳng $AB$ (tham khảo hình vẽ). Khi đó:
      </p>

      <div class="flex justify-center my-4">
        <svg width="210" height="210" viewBox="0 0 210 210" class="border border-slate-200 rounded-lg bg-slate-50">
          <rect x="45" y="45" width="120" height="120" fill="none" stroke="#0f172a" stroke-width="2" />
          <line x1="45" y1="45" x2="165" y2="165" stroke="#64748b" stroke-width="1.2" stroke-dasharray="4 3" />
          <line x1="165" y1="45" x2="45" y2="165" stroke="#64748b" stroke-width="1.2" stroke-dasharray="4 3" />
          <circle cx="105" cy="105" r="3" fill="#dc2626" />
          <circle cx="105" cy="45" r="3" fill="#2563eb" />
          <text x="28" y="42" font-size="14" font-weight="bold" fill="#0f172a">A</text>
          <text x="170" y="42" font-size="14" font-weight="bold" fill="#0f172a">B</text>
          <text x="170" y="177" font-size="14" font-weight="bold" fill="#0f172a">C</text>
          <text x="28" y="177" font-size="14" font-weight="bold" fill="#0f172a">D</text>
          <text x="100" y="34" font-size="14" font-weight="bold" fill="#2563eb">M</text>
          <text x="112" y="114" font-size="14" font-weight="bold" fill="#dc2626">O</text>
        </svg>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full border-collapse border border-slate-300 text-sm">
          <thead>
            <tr class="bg-slate-100">
              <th class="border border-slate-300 p-2.5 text-left">Mệnh đề</th>
              <th class="border border-slate-300 p-2.5 w-20 text-center">Đúng</th>
              <th class="border border-slate-300 p-2.5 w-20 text-center">Sai</th>
            </tr>
          </thead>
          <tbody id="phan2-body"></tbody>
        </table>
      </div>
    </div>

    <!-- PHẦN III -->
    <div class="card p-6">
      <h2 class="text-lg font-bold text-blue-800 border-b border-slate-200 pb-2 mb-4">
        PHẦN III. Câu trắc nghiệm trả lời ngắn
      </h2>
      <div id="phan3-list" class="space-y-4"></div>
    </div>

    <!-- PHẦN IV -->
    <div class="card p-6">
      <h2 class="text-lg font-bold text-blue-800 border-b border-slate-200 pb-2 mb-4">
        PHẦN IV. Tự luận
      </h2>
      <p class="font-medium text-slate-800 mb-1.5">
        <strong>Câu 1.</strong> Trong mặt phẳng tọa độ $Oxy$, cho ba điểm $A(-3;2)$; $B(1;3)$; $C(4;-1)$.
      </p>
      <p class="ml-4 text-sm text-slate-700">a. Tính tọa độ $\vec{AB}$.</p>
      <p class="ml-4 text-sm text-slate-700 mb-3">b. Tính tọa độ trọng tâm tam giác $ABC$.</p>
      <textarea id="tuLuan" rows="5" placeholder="Nhập lời giải tự luận của em tại đây..."
        class="w-full border border-slate-300 rounded-lg p-3 focus:outline-none focus:border-blue-500"></textarea>
    </div>

    <!-- Nút nộp bài -->
    <div class="text-center pb-4">
      <button id="btnNop" type="button" onclick="nopBai()"
        class="bg-blue-600 hover:bg-blue-700 disabled:bg-slate-400 text-white font-bold px-8 py-3 rounded-xl shadow transition">
        NỘP BÀI & GỬI KẾT QUẢ VỀ SHEET
      </button>
    </div>

    <!-- Kết quả -->
    <div id="ketQuaBox" class="hidden card p-6 border-2 border-emerald-500 bg-emerald-50 mb-8"></div>
  </div>

  <script>
    // DÁN LINK WEB APP GOOGLE APPS SCRIPT CỦA THẦY VÀO ĐÂY:
    const SHEET_WEBAPP_URL = "https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec";

    const phan1Data = [
      {
        key: "Câu 1",
        q: "Câu 1. Trong mặt phẳng tọa độ $Oxy$, tọa độ của vectơ $\\vec{i}$ là:",
        opts: ["A. $\\vec{i}=(1;0)$.", "B. $\\vec{i}=(0;1)$.", "C. $\\vec{i}=(1;1)$.", "D. $\\vec{i}=(0;0)$."],
        ans: 0
      },
      {
        key: "Câu 3",
        q: "Câu 3. Trong mặt phẳng tọa độ $Oxy$ cho vectơ $\\vec{u}=3\\vec{i}-4\\vec{j}$. Tọa độ của vectơ $\\vec{u}$ là:",
        opts: ["A. $\\vec{u}=(3;-4)$.", "B. $\\vec{u}=(3;4)$.", "C. $\\vec{u}=(-3;-4)$.", "D. $\\vec{u}=(-3;4)$."],
        ans: 0
      },
      {
        key: "Câu 5",
        q: "Câu 5. Cho hình bình hành $ABCD$. Vectơ nào sau đây bằng với vectơ $\\vec{AB}$?",
        opts: ["A. $\\vec{BC}$.", "B. $\\vec{BD}$.", "C. $\\vec{DC}$.", "D. $\\vec{AC}$."],
        ans: 2
      },
      {
        key: "Câu 7",
        q: "Câu 7. Cho hình chữ nhật $ABCD$ với $AB=3$; $AD=4$. Khi đó độ dài vectơ $\\vec{AC}$ bằng bao nhiêu?",
        opts: ["A. $7$.", "B. $3$.", "C. $5$.", "D. $4$."],
        ans: 2
      },
      {
        key: "Câu 8",
        q: "Câu 8. Cho tứ giác $ABCD$. Có bao nhiêu vectơ khác $\\vec{0}$ và có điểm đầu điểm cuối chỉ lấy trong các điểm $A, B, C, D$?",
        opts: ["A. $10$.", "B. $12$.", "C. $8$.", "D. $6$."],
        ans: 1
      },
      {
        key: "Câu 10",
        q: "Câu 10. Giá trị của $\\cos 60^{\\circ}$ bằng:",
        opts: ["A. $-\\frac{\\sqrt{3}}{2}$.", "B. $-\\frac{1}{2}$.", "C. $\\frac{\\sqrt{3}}{2}$.", "D. $\\frac{1}{2}$."],
        ans: 3
      },
      {
        key: "Câu 12",
        q: "Câu 12. Trong mặt phẳng tọa độ $Oxy$, cho vectơ $\\vec{a}=(x;y)$, $\\vec{b}=(x';y')$. $\\vec{a}=\\vec{b}$ khi:",
        opts: [
          "A. $\\begin{cases}x=x'\\\\y=y'\\end{cases}$",
          "B. $\\begin{cases}x=-y'\\\\y=x'\\end{cases}$",
          "C. $\\begin{cases}x=x'\\\\y=-y'\\end{cases}$",
          "D. $\\begin{cases}x=y'\\\\y=x'\\end{cases}$"
        ],
        ans: 0
      }
    ];

    const phan2Data = [
      { id: "p2_a", text: "a) $\\vec{OC}=\\vec{AO}$.", ans: "D" },
      { id: "p2_b", text: "b) $\\vec{AD}-\\vec{AB}=\\vec{BD}$.", ans: "D" },
      { id: "p2_c", text: "c) $\\vec{AB}\\cdot\\vec{AC}=\\frac{a^2\\sqrt{2}}{2}$.", ans: "S" },
      { id: "p2_d", text: "d) $\\vec{CM}=\\frac{1}{2}\\vec{AC}-\\frac{1}{2}\\vec{BC}$.", ans: "S" }
    ];

    const phan3Data = [
      {
        id: "p3_c2",
        label: "Câu 2",
        q: "Câu 2. Cho ba lực $\\vec{F_1}=\\vec{MA}$, $\\vec{F_2}=\\vec{MB}$, $\\vec{F_3}=\\vec{MC}$ cùng tác động vào một ô tô tại điểm $M$ và ô tô đứng yên. Cho biết cường độ hai lực $\\vec{F_1}, \\vec{F_2}$ đều bằng $35\\text{N}$ và góc $\\widehat{AMB}=64^{\\circ}$. Khi đó tính cường độ $\\vec{F_3}$ (làm tròn đến hàng phần chục):",
        ans: 59.3
      },
      {
        id: "p3_c3",
        label: "Câu 3",
        q: "Câu 3. Cho tam giác $ABC$ có $AB=4, BC=7, \\cos B=\\frac{4}{5}$. Khi đó độ dài cạnh $AC$ bằng bao nhiêu? (làm tròn đến hàng phần trăm):",
        ans: 4.50
      },
      {
        id: "p3_c4",
        label: "Câu 4",
        q: "Câu 4. Trong mặt phẳng tọa độ $Oxy$, cho vectơ $\\vec{u}=(1;2)$; $\\vec{v}=(3;-5)$. Tích vô hướng của $\\vec{u}$ và $\\vec{v}$ bằng $a$. Khi đó giá trị của $35\\cdot a$ bằng bao nhiêu?",
        ans: -245
      }
    ];

    document.addEventListener("DOMContentLoaded", () => {
      const p1Container = document.getElementById("phan1-list");
      phan1Data.forEach((item, idx) => {
        const optsHtml = item.opts.map((opt, oIdx) => `
          <label class="flex items-center gap-2 p-2 rounded-lg hover:bg-blue-50 cursor-pointer">
            <input type="radio" name="p1_${idx}" value="${oIdx}" class="w-4 h-4 text-blue-600" />
            <span>${opt}</span>
          </label>
        `).join("");

        p1Container.insertAdjacentHTML("beforeend", `
          <div class="p-3.5 rounded-lg bg-slate-50 border border-slate-200">
            <p class="font-medium text-slate-800 mb-2">${item.q}</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">${optsHtml}</div>
          </div>
        `);
      });

      const p2Body = document.getElementById("phan2-body");
      phan2Data.forEach(item => {
        p2Body.insertAdjacentHTML("beforeend", `
          <tr>
            <td class="border border-slate-300 p-2.5">${item.text}</td>
            <td class="border border-slate-300 p-2.5 text-center">
              <input type="radio" name="${item.id}" value="D" class="w-4 h-4" />
            </td>
            <td class="border border-slate-300 p-2.5 text-center">
              <input type="radio" name="${item.id}" value="S" class="w-4 h-4" />
            </td>
          </tr>
        `);
      });

      const p3Container = document.getElementById("phan3-list");
      phan3Data.forEach(item => {
        p3Container.insertAdjacentHTML("beforeend", `
          <div class="p-3.5 rounded-lg bg-slate-50 border border-slate-200">
            <p class="font-medium text-slate-800 mb-2">${item.q}</p>
            <input id="${item.id}" type="text" placeholder="Nhập đáp số (ví dụ: 59,3 hoặc 59.3)"
              class="w-full sm:w-64 border border-slate-300 rounded-lg px-3 py-1.5 bg-white focus:outline-none focus:border-blue-500" />
          </div>
        `);
      });

      if (window.MathJax && window.MathJax.typesetPromise) {
        window.MathJax.typesetPromise();
      }
    });

    async function nopBai() {
      const hoTen = document.getElementById("hoTen").value.trim();
      const lop = document.getElementById("lop").value.trim();
      if (!hoTen || !lop) {
        alert("Vui lòng nhập đầy đủ Họ và tên và Lớp.");
        return;
      }

      if (!SHEET_WEBAPP_URL || SHEET_WEBAPP_URL.includes("YOUR_DEPLOYMENT_ID")) {
        alert("Thầy chưa cấu hình đường link Web App Google Apps Script trong biến SHEET_WEBAPP_URL.");
        return;
      }

      const labels = ["A", "B", "C", "D"];
      const chiTiet = [];

      // Phần I: thang 3 điểm chia đều theo số câu hiện có
      let dungP1 = 0;
      phan1Data.forEach((item, idx) => {
        const chosen = document.querySelector(`input[name="p1_${idx}"]:checked`);
        const val = chosen ? parseInt(chosen.value, 10) : -1;
        chiTiet.push(`${item.key}: ${val >= 0 ? labels[val] : "Trống"}`);
        if (val === item.ans) dungP1++;
      });
      const diemP1 = Number(((dungP1 / phan1Data.length) * 3).toFixed(2));

      // Phần II: thang 2 điểm theo số ý đúng (1 ý: 0.2; 2 ý: 0.5; 3 ý: 1.0; 4 ý: 2.0)
      let dungP2 = 0;
      phan2Data.forEach(item => {
        const chosen = document.querySelector(`input[name="${item.id}"]:checked`);
        const val = chosen ? chosen.value : "Trống";
        chiTiet.push(`${item.id}: ${val}`);
        if (val === item.ans) dungP2++;
      });
      const thangDiemP2 = [0, 0.2, 0.5, 1.0, 2.0];
      const diemP2 = thangDiemP2[dungP2];

      // Phần III: thang 2 điểm chia đều theo số câu hiện có
      let dungP3 = 0;
      phan3Data.forEach(item => {
        const raw = document.getElementById(item.id).value.trim().replace(",", ".");
        chiTiet.push(`${item.label}: ${raw || "Trống"}`);
        const num = parseFloat(raw);
        if (!Number.isNaN(num) && Math.abs(num - item.ans) <= 0.05) {
          dungP3++;
        }
      });
      const diemP3 = Number(((dungP3 / phan3Data.length) * 2).toFixed(2));

      const tongTN = Number((diemP1 + diemP2 + diemP3).toFixed(2));
      const tuLuan = document.getElementById("tuLuan").value.trim();

      const btn = document.getElementById("btnNop");
      btn.disabled = true;
      btn.textContent = "ĐANG GỬI DỮ LIỆU VỀ GOOGLE SHEET...";

      const payload = {
        hoTen,
        lop,
        diemP1,
        diemP2,
        diemP3,
        tongTN,
        chiTiet: chiTiet.join(" | "),
        tuLuan
      };

      try {
        // Dùng mode: 'no-cors' để gửi POST từ GitHub sang Google Apps Script ổn định không vướng CORS preflight
        await fetch(SHEET_WEBAPP_URL, {
          method: "POST",
          mode: "no-cors",
          headers: { "Content-Type": "text/plain;charset=utf-8" },
          body: JSON.stringify(payload)
        });

        btn.textContent = "ĐÃ NỘP BÀI THÀNH CÔNG";
        btn.classList.remove("bg-blue-600", "hover:bg-blue-700");
        btn.classList.add("bg-emerald-600");

        const box = document.getElementById("ketQuaBox");
        box.classList.remove("hidden");
        box.innerHTML = `
          <h3 class="text-lg font-bold text-emerald-900 mb-2">Đã chấm điểm và gửi kết quả về Google Sheet</h3>
          <p class="text-sm text-slate-700"><strong>Học sinh:</strong> ${hoTen} — <strong>Lớp:</strong> ${lop}</p>
          <ul class="list-disc ml-5 mt-2 space-y-1 text-sm text-slate-800">
            <li>Điểm Phần I: <strong>${diemP1}</strong> (${dungP1}/${phan1Data.length} câu đúng)</li>
            <li>Điểm Phần II: <strong>${diemP2}</strong> (${dungP2}/${phan2Data.length} ý đúng)</li>
            <li>Điểm Phần III: <strong>${diemP3}</strong> (${dungP3}/${phan3Data.length} câu đúng)</li>
          </ul>
          <p class="text-base font-bold text-blue-900 mt-3">Tổng điểm trắc nghiệm: ${tongTN}</p>
          <p class="text-xs text-slate-600 mt-1">Phần tự luận đã được gửi lên Google Sheet để giáo viên kiểm tra.</p>
        `;
      } catch (err) {
        alert("Gửi dữ liệu chưa thành công. Vui lòng thử lại.");
        btn.disabled = false;
        btn.textContent = "NỘP BÀI & GỬI KẾT QUẢ VỀ SHEET";
      }
    }
  </script>
</body>
</html>
